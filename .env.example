NODE_ENV=development
PORT=3000

# Comma-separated allow-list of origins allowed to make cross-origin browser
# requests (native mobile clients are unaffected either way). Only relevant
# to the Expo "web" target and any future browser-based client. Unset in
# production means no cross-origin access at all (fails closed); dev/test
# default to permissive when unset.
# CORS_ALLOWED_ORIGINS=http://localhost:8081,https://app.example.com

# Postgres (matches docker-compose.yml service defaults)
DATABASE_URL="postgresql://sidequest:sidequest@localhost:5432/sidequest?schema=public"

# Redis (BullMQ + caching)
REDIS_URL="redis://localhost:6379"
# Seconds the active-mission-pool cache is valid for; must be a positive
# number (the app fails to boot on an invalid value). Optional, defaults to 60.
# MISSION_POOL_CACHE_TTL_SECONDS=60

# Auth
JWT_SECRET="change-me-in-every-environment"
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL="30d"
GUEST_TOKEN_TTL="90d"

# Admin portal auth (Phase 4). A SEPARATE JWT secret from JWT_SECRET above so the
# admin surface and the end-user surface share no signing key — a leak of one
# never compromises the other. The admin-jwt strategy pins algorithms:['HS256'].
# Required at boot (the app fails closed if unset). Generate a long random value
# per environment (e.g. `openssl rand -hex 32`) and set it via `railway variables
# set` (prod) or a local .env (dev) — never paste a real value into chat.
ADMIN_JWT_SECRET="change-me-in-every-environment-admin"
# Access tokens are short-lived; the per-request AdminSession revocation check
# makes forced-logout immediate regardless of TTL. Optional (defaults 15m/12h).
ADMIN_JWT_ACCESS_TOKEN_TTL="15m"
ADMIN_JWT_REFRESH_TOKEN_TTL="12h"

# Key used to encrypt admin TOTP secrets at rest (AES-256-GCM). Any sufficiently
# random value works (normalized to 32 bytes via SHA-256). Required at boot.
# Rotating this key invalidates existing enrolled MFA secrets (admins must
# re-enroll), so treat it as durable. Generate with `openssl rand -hex 32`.
ADMIN_MFA_ENCRYPTION_KEY="change-me-in-every-environment-mfa-key"

# Base URL of the admin portal web app, used to build password-reset / invite
# links in emails. Optional; defaults to http://localhost:3001 in dev.
# ADMIN_PORTAL_URL="https://admin.example.com"

# Google Sign-In. Both are the OAuth 2.0 *client IDs* (not secrets) that a
# Google ID token's `aud` claim is verified against — one for the Expo web
# target, one for the native iOS app. Create them in Google Cloud Console →
# APIs & Services → Credentials. Required at boot (the app fails closed if
# unset). Placeholder values below let the service start and unit tests run;
# swap in the real client IDs before Google Sign-In will accept live tokens.
GOOGLE_OAUTH_WEB_CLIENT_ID="REPLACE_WITH_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_OAUTH_IOS_CLIENT_ID="REPLACE_WITH_GOOGLE_IOS_CLIENT_ID.apps.googleusercontent.com"

# Rate limiting (requests per ttl window, in ms)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Push notifications (M21) — Expo Push Notifications (Decision 6). Delivery goes
# through the `notifications` BullMQ queue; the in-app notification store works
# with neither var set.
#
# EXPO_ACCESS_TOKEN (optional): an Expo access token for enhanced-security push
# sends. Unset means unauthenticated sends, which Expo permits and which is fine
# for dev / Expo Go. Set the real value via `railway variables set` (prod) or a
# local .env (dev); never paste it into chat. Create it at
# https://expo.dev/accounts/[account]/settings/access-tokens
# EXPO_ACCESS_TOKEN=

# Minutes to wait after a push send before polling Expo delivery receipts to
# invalidate dead device tokens. Optional; must be a positive number (a
# bad/zero value falls back to the default). Defaults to 15.
# PUSH_RECEIPT_CHECK_DELAY_MINUTES=15

# Hours a mission Completion stays Pending before the BullMQ auto-approve job
# flips it to Approved (verifiedBy = "auto"), unless an admin manually resolves
# it first via PATCH /admin/completions/:id/verification. Optional; must be a
# positive number (a bad/zero value falls back to the default). Defaults to 24.
# PROOF_AUTO_APPROVE_TIMEOUT_HOURS=24

# Shared secret for the userless admin routes (sent in the x-admin-key header;
# see AdminGuard). There is no per-admin identity yet — this single key gates
# every /admin route. Required for admin access at request time (NOT at boot):
# the guard fails CLOSED, so an unset/empty value makes every admin request 403
# rather than crashing the app or falling open. Generate a long random value
# per environment (e.g. `openssl rand -hex 32`) and set it directly via
# `railway variables set` (prod) or a local .env (dev) — never paste a real
# value into chat.
# ADMIN_API_KEY="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Admin portal bootstrap (Phase 3, web platform). Used ONLY by `prisma db seed`
# to create the first Owner admin when none exists yet — never read at request
# time. Both must be set for the Owner to be created; if either is unset the seed
# skips Owner creation (so CI / mission-only seeds still run). The seed is
# idempotent: once an Owner exists it is never re-created or password-reset.
#
# The password must satisfy the admin policy (12+ chars, at least 3 of:
# lowercase, uppercase, digit, symbol). The seeded Owner is forced to change its
# password AND enroll MFA on first login, so this is a one-time bootstrap secret,
# not a durable credential. Set it directly via `railway variables set` (prod) or
# a local .env (dev) — never paste a real value into chat.
# ADMIN_BOOTSTRAP_EMAIL="owner@example.com"
# ADMIN_BOOTSTRAP_PASSWORD="REPLACE_WITH_A_STRONG_TEMPORARY_PASSWORD"

# Proof-submission photo storage (S3-compatible).
#
# Default (zero-setup, this file's values): points at the LocalStack container
# in docker-compose.yml — credentials are unchecked dummy values, LocalStack
# doesn't validate them. Bucket must exist first:
#   docker compose up -d localstack
#   docker exec <project>-localstack-1 awslocal s3 mb s3://sidequest-proofs-dev
#
# Real AWS S3: comment out S3_ENDPOINT/S3_FORCE_PATH_STYLE (unset = SDK
# resolves the real regional endpoint), set S3_REGION to the bucket's actual
# region (not just its default — check with `aws s3api get-bucket-location`,
# a wrong region 301s), and set real AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
S3_ENDPOINT="http://localhost:4566"
S3_FORCE_PATH_STYLE=true
S3_REGION="us-east-1"
S3_BUCKET="sidequest-proofs-dev"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"

# Stripe — payment-methods-on-file (SetupIntent + card attach/detach/set-default).
# There is NO charge flow: nothing is ever billed, cards are only kept on record.
#
# STRIPE_SECRET_KEY is the server-side secret (sk_test_... in test mode,
# sk_live_... in production) — a real secret, NOT a publishable key. Create it in
# the Stripe Dashboard → Developers → API keys. Required at boot (the app fails
# closed if unset). The placeholder below lets the service start and unit tests
# run; every real Stripe API call will fail cleanly with a 401 (mapped to 502)
# until a real test-mode key is set — it is NOT mocked to fake success. Set the
# real value directly via `railway variables set` (prod) or a local .env (dev),
# never paste it into chat.
STRIPE_SECRET_KEY="sk_test_placeholder_not_a_real_key"

# STRIPE_WEBHOOK_SECRET (whsec_...) — RESERVED, unused by this milestone. There
# is no webhook endpoint yet; this is documented ahead of future work if the
# payment surface grows beyond payment-methods-on-file. Leave as the placeholder
# until a webhook handler exists.
STRIPE_WEBHOOK_SECRET="whsec_placeholder_not_a_real_secret"
