NODE_ENV=development
PORT=3000

# Postgres (matches docker-compose.yml service defaults)
DATABASE_URL="postgresql://sidequest:sidequest@localhost:5432/sidequest?schema=public"

# Redis (BullMQ + caching)
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-in-every-environment"
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL="30d"
GUEST_TOKEN_TTL="90d"

# Rate limiting (requests per ttl window, in ms)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Proof-submission photo storage (S3-compatible).
# Local dev/test: points at the LocalStack container in docker-compose.yml —
# credentials are unchecked dummy values, LocalStack doesn't validate them.
# Production: unset S3_ENDPOINT (SDK resolves the real AWS endpoint from
# S3_REGION) and set real AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/S3_BUCKET.
S3_ENDPOINT="http://localhost:4566"
S3_FORCE_PATH_STYLE=true
S3_REGION="us-east-1"
S3_BUCKET="sidequest-proofs-dev"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
