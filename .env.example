NODE_ENV=development
PORT=3000

# Comma-separated allow-list of origins allowed to make cross-origin browser
# requests (native mobile clients are unaffected either way). Only relevant
# to the Expo "web" target and any future browser-based client. Unset in
# production means no cross-origin access at all (fails closed); dev/test
# default to permissive when unset.
# CORS_ALLOWED_ORIGINS=http://localhost:8081,https://app.example.com

# Postgres (matches docker-compose.yml service defaults)
DATABASE_URL="postgresql://sidequest:sidequest@localhost:5432/sidequest?schema=public"

# Redis (BullMQ + caching)
REDIS_URL="redis://localhost:6379"
# Seconds the active-mission-pool cache is valid for; must be a positive
# number (the app fails to boot on an invalid value). Optional, defaults to 60.
# MISSION_POOL_CACHE_TTL_SECONDS=60

# Auth
JWT_SECRET="change-me-in-every-environment"
JWT_ACCESS_TOKEN_TTL="15m"
JWT_REFRESH_TOKEN_TTL="30d"
GUEST_TOKEN_TTL="90d"

# Google Sign-In. Both are the OAuth 2.0 *client IDs* (not secrets) that a
# Google ID token's `aud` claim is verified against — one for the Expo web
# target, one for the native iOS app. Create them in Google Cloud Console →
# APIs & Services → Credentials. Required at boot (the app fails closed if
# unset). Placeholder values below let the service start and unit tests run;
# swap in the real client IDs before Google Sign-In will accept live tokens.
GOOGLE_OAUTH_WEB_CLIENT_ID="REPLACE_WITH_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_OAUTH_IOS_CLIENT_ID="REPLACE_WITH_GOOGLE_IOS_CLIENT_ID.apps.googleusercontent.com"

# Rate limiting (requests per ttl window, in ms)
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Hours a mission Completion stays Pending before the BullMQ auto-approve job
# flips it to Approved (verifiedBy = "auto"), unless an admin manually resolves
# it first via PATCH /admin/completions/:id/verification. Optional; must be a
# positive number (a bad/zero value falls back to the default). Defaults to 24.
# PROOF_AUTO_APPROVE_TIMEOUT_HOURS=24

# Shared secret for the userless admin routes (sent in the x-admin-key header;
# see AdminGuard). There is no per-admin identity yet — this single key gates
# every /admin route. Required for admin access at request time (NOT at boot):
# the guard fails CLOSED, so an unset/empty value makes every admin request 403
# rather than crashing the app or falling open. Generate a long random value
# per environment (e.g. `openssl rand -hex 32`) and set it directly via
# `railway variables set` (prod) or a local .env (dev) — never paste a real
# value into chat.
# ADMIN_API_KEY="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Proof-submission photo storage (S3-compatible).
#
# Default (zero-setup, this file's values): points at the LocalStack container
# in docker-compose.yml — credentials are unchecked dummy values, LocalStack
# doesn't validate them. Bucket must exist first:
#   docker compose up -d localstack
#   docker exec <project>-localstack-1 awslocal s3 mb s3://sidequest-proofs-dev
#
# Real AWS S3: comment out S3_ENDPOINT/S3_FORCE_PATH_STYLE (unset = SDK
# resolves the real regional endpoint), set S3_REGION to the bucket's actual
# region (not just its default — check with `aws s3api get-bucket-location`,
# a wrong region 301s), and set real AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY.
S3_ENDPOINT="http://localhost:4566"
S3_FORCE_PATH_STYLE=true
S3_REGION="us-east-1"
S3_BUCKET="sidequest-proofs-dev"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
